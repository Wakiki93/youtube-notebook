# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).

# ---------- Postiz: posts the Reels to Instagram ----------
# Postiz Cloud (easiest): https://api.postiz.com/public/v1
# Self-hosted on this machine: http://host.docker.internal:4007/api/public/v1
POSTIZ_API_URL=https://api.postiz.com/public/v1
# Postiz > Settings > Developers > Public API
POSTIZ_API_KEY=
# Only needed if more than one Instagram account is connected in Postiz (`acp check` lists them)
POSTIZ_INTEGRATION_ID=
# draft = posts wait in the Postiz calendar for you to approve (start here)
# schedule = posts go live on their own at POST_TIMES
# now = publish immediately (for testing only)
POST_MODE=draft
# Let Postiz re-encode videos to Instagram's specs (Postiz Cloud; no effect on most self-hosts)
POSTIZ_ADJUST_MEDIA=true

# ---------- Schedule ----------
TIMEZONE=America/Chicago
# One Reel per time, every day
POST_TIMES=09:00,18:00
# When the daily cycle runs (clips new links if needed, then fills the next day's slots)
RUN_AT=06:00

# ---------- AutoClip: picks the best moments and makes captioned 9:16 Reels ----------
# It needs one AI model to judge which moments are worth clipping. Pick ONE provider:
#   openai | gemini | deepseek | dashscope | grok | kimi | glm  (see AutoClip docs for more)
LLM_PROVIDER=openai
API_MODEL_NAME=gpt-4o-mini
API_OPENAI_API_KEY=
# API_GEMINI_API_KEY=
# API_DEEPSEEK_API_KEY=
# Reels to take from each long video (AutoClip makes up to 10)
CLIPS_PER_VIDEO=5
# Optional look: classic | editorial | street
AUTOCLIP_TEMPLATE=
# Optional plain-English steer for picking moments, e.g. "favor practical advice and strong opinions"
AUTOCLIP_INSTRUCTION=
# Seconds to wait for one video before giving up
AUTOCLIP_TIMEOUT=7200

# ---------- Captions ----------
# Added under every caption. Use \n for a new line.
CAPTION_FOOTER=Follow for a new clip every day
MAX_HASHTAGS=10

# ---------- Safety ----------
# true = do everything except upload or post; prints what it would have posted
DRY_RUN=false
